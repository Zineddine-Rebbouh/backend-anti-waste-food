# ========================
# Django Core
# ========================
SECRET_KEY=your-super-secret-key-change-this-in-production-min-50-chars
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ========================
# Database
# ========================
DATABASE_URL=postgresql://savefood_user:savefood_pass@localhost:5432/savefood_db

# ========================
# Redis
# ========================
REDIS_URL=redis://localhost:6379/0

# ========================
# Celery
# ========================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ========================
# AWS S3 / MinIO (File Storage)
# ========================
USE_S3=False
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=savefood-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_CUSTOM_DOMAIN=

# ========================
# Email
# ========================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=your-sendgrid-api-key
DEFAULT_FROM_EMAIL=noreply@savefood.dz

# ========================
# SMS
# ========================
SMS_PROVIDER=twilio
SMS_PROVIDER_ACCOUNT_SID=your-twilio-account-sid
SMS_PROVIDER_AUTH_TOKEN=your-twilio-auth-token
SMS_PROVIDER_PHONE_NUMBER=+213XXXXXXXXX

# ========================
# JWT Authentication
# ========================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# ========================
# Sentry (Error Tracking)
# ========================
SENTRY_DSN=
ENVIRONMENT=development

# ========================
# CORS
# ========================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# ========================
# Frontend
# ========================
FRONTEND_URL=http://localhost:3000

# ========================
# Rate Limiting
# ========================
RATELIMIT_ENABLE=True
AUTH_RATELIMIT=5/15m
API_RATELIMIT=100/m
